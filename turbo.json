{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "JWT_SECRET",
    "AUTH_COOKIE_NAME",
    "AUTH_COOKIE_MAXAGE_S",
    "PASSWORD_MIN_LENGTH",
    "PASSWORD_RESET_TTL_MINUTES",
    "SMTP_EMAIL",
    "SMTP_PASSWORD",
    "SENDER_NAME",
    "CRON_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "VERCEL_URL",
    "GEMINI_API_KEYS",
    "GEMINI_MODEL",
    "GROQ_API_KEYS",
    "GROQ_LLM_FALLBACK_MODEL",
    "GROQ_WHISPER_MODEL",
    "GITHUB_TOKEN",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "AUDIO_SERVICE_URL",
    "MAX_AUDIO_SECONDS",
    "MAX_AUDIO_MB",
    "PRESIGN_EXPIRY_SECONDS",
    "DEFAULT_NUM_QUESTIONS",
    "PROVIDER_TIMEOUT_MS",
    "ROTATION_BASE_BACKOFF_MS",
    "TTS_ENABLED",
    "GROQ_TTS_MODEL",
    "TTS_DAILY_BUDGET",
    "TTS_CACHE_PREFIX",
    "TTS_MAX_CHARS",
    "NEXT_PUBLIC_LOCAL_TTS",
    "GEMINI_TTS_ENABLED",
    "GEMINI_TTS_MODEL",
    "GEMINI_TTS_DAILY_BUDGET",
    "GEMINI_TTS_CACHE_PREFIX",
    "DRILL_DAILY_CARDS",
    "DRILL_DIGEST_DAYS",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@repo/db#build": {
      "inputs": ["prisma/**", "prisma.config.ts", "package.json"],
      "outputs": ["generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "@repo/db#check-types": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
