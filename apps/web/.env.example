# Grill — apps/web configuration.
# Copy to .env.local and fill in. NEVER commit real values: .env* is gitignored,
# and a leaked JWT_SECRET lets anyone forge a login cookie for any user.

# ── Required ──────────────────────────────────────────────────────────
# Neon Postgres. Tables live in the `ai_interview` schema, not `public` —
# keep the ?schema= param or every query 404s on "relation does not exist".
# Runtime uses the -pooler host; packages/db/.env uses the direct host for CLI migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&schema=ai_interview"

# Signs the session cookie. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# Comma-separated. Rotated per call by the key pool; `LABEL__SPLIT__KEY` gives
# redacted logs a name to print instead of the secret. Bare keys also work.
GEMINI_API_KEYS="MY_KEY_1__SPLIT__AIza...,MY_KEY_2__SPLIT__AIza..."

# ── Strongly recommended ──────────────────────────────────────────────
# Without these, transcription (Whisper) and the Gemini→Groq fallback are off,
# which means voice answers don't work at all.
GROQ_API_KEYS="gsk_...,gsk_..."

# Cloudflare R2 (S3-compatible). Without all four, audio can't be stored.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="your-bucket"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The Python acoustics service (apps/audio). In production this MUST point at the
# deployed FastAPI URL — on Vercel, localhost:8000 doesn't exist, so pitch/energy
# silently come back null and the report loses tonality without erroring.
AUDIO_SERVICE_URL="http://localhost:8000"

# ── Optional (defaults shown) ─────────────────────────────────────────
GEMINI_MODEL="gemini-2.5-flash"
GROQ_LLM_FALLBACK_MODEL="openai/gpt-oss-120b"
GROQ_WHISPER_MODEL="whisper-large-v3"

AUTH_COOKIE_NAME="grill_session"
AUTH_COOKIE_MAXAGE_S="1209600"
PASSWORD_MIN_LENGTH="8"

DEFAULT_NUM_QUESTIONS="8"
MAX_AUDIO_SECONDS="180"
MAX_AUDIO_MB="25"
PRESIGN_EXPIRY_SECONDS="300"

PROVIDER_TIMEOUT_MS="30000"
ROTATION_BASE_BACKOFF_MS="300"
