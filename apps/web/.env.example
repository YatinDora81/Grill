# Grill — apps/web configuration.
# Copy to .env.local and fill in. NEVER commit real values: .env* is gitignored,
# and a leaked JWT_SECRET lets anyone forge a login cookie for any user.

# ── Required ──────────────────────────────────────────────────────────
# Neon Postgres. Tables live in the `ai_interview` schema, not `public` —
# keep the ?schema= param or every query 404s on "relation does not exist".
# Runtime uses the -pooler host; packages/db/.env uses the direct host for CLI migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&schema=ai_interview"

# Signs the session cookie. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# Comma-separated. Rotated per call by the key pool; `LABEL__SPLIT__KEY` gives
# redacted logs a name to print instead of the secret. Bare keys also work.
GEMINI_API_KEYS="MY_KEY_1__SPLIT__AIza...,MY_KEY_2__SPLIT__AIza..."

# ── Strongly recommended ──────────────────────────────────────────────
# Without these, transcription (Whisper) and the Gemini→Groq fallback are off,
# which means voice answers don't work at all.
GROQ_API_KEYS="gsk_...,gsk_..."

# GitHub repo imports for project interviews. One import costs ~3 API requests
# (metadata + languages + tarball), so even GitHub's unauthenticated 60/hour
# PER-IP limit survives light use — but serverless egress IPs are shared, so
# set a classic PAT (public repo read, no scopes) to raise it to 5,000/hour.
GITHUB_TOKEN=""

# Cloudflare R2 (S3-compatible). Without all four, audio can't be stored.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="your-bucket"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The Python acoustics service (apps/audio). In production this MUST point at the
# deployed FastAPI URL — on Vercel, localhost:8000 doesn't exist, so pitch/energy
# silently come back null and the report loses tonality without erroring.
AUDIO_SERVICE_URL="http://localhost:8000"

# Bearer token Vercel signs cron invocations with. /api/cron/reports refuses to
# run without it rather than defaulting open — an unauthenticated sweep is a way
# for a stranger to run your LLM bill up. Vercel sets this for you in production;
# leave it unset locally and the route 404s, which is correct.
CRON_SECRET=""

# Canonical origin, no trailing slash. Backs `metadataBase`, so canonical URLs
# and the Open Graph image resolve absolutely. Unset, previews fall back to
# VERCEL_URL (correct per deployment) and local dev to http://localhost:4000 —
# but production MUST set this, or every canonical points at the deployment hash
# instead of the domain.
NEXT_PUBLIC_SITE_URL="http://localhost:4000"

# ── Optional (defaults shown) ─────────────────────────────────────────
GEMINI_MODEL="gemini-2.5-flash"
GROQ_LLM_FALLBACK_MODEL="openai/gpt-oss-120b"
GROQ_WHISPER_MODEL="whisper-large-v3"

AUTH_COOKIE_NAME="grill_session"
AUTH_COOKIE_MAXAGE_S="1209600"
PASSWORD_MIN_LENGTH="8"

DEFAULT_NUM_QUESTIONS="8"
MAX_AUDIO_SECONDS="180"
MAX_AUDIO_MB="25"
# Answer clips are deleted this many days after the interview started, by the
# same daily cron that purges video. Matches VIDEO_RETENTION_DAYS below on
# purpose — both are recordings of the same interview. Transcripts, scores and
# reports are NOT affected; only the audio goes.
AUDIO_RETENTION_DAYS="100"
PRESIGN_EXPIRY_SECONDS="300"

PROVIDER_TIMEOUT_MS="30000"
ROTATION_BASE_BACKOFF_MS="300"

# Session video. Recording rides on the same R2 bucket as audio, so the S3_* vars
# above are what actually gate it — these only tune it.
VIDEO_RETENTION_DAYS="100"
# 640x480 talking head. Raising this is the fastest way to a surprise R2 bill:
# an hour at 400kbps is ~180 MB, at 2Mbps it's ~900 MB.
VIDEO_BITS_PER_SECOND="400000"
VIDEO_PART_URL_EXPIRY_S="900"
# Playback re-authorises the presigned GET on every Range request the <video>
# element makes, so a short expiry 403s mid-scrub. Keep this well above the
# longest interview you allow.
VIDEO_PLAYBACK_EXPIRY_S="3600"
# 5 MiB parts x 2000 = ~10 GB ceiling per session.
VIDEO_MAX_PARTS="2000"

# ── Outbound email (password reset) ───────────────────────────────────
# Gmail SMTP. SMTP_PASSWORD must be a 16-character App Password from
# https://myaccount.google.com/apppasswords — Google rejects the account
# password over SMTP, and an App Password is revocable on its own.
#
# All three are soft-optional: unset, /api/auth/forgot-password still answers
# 200 (it must never reveal whether an address is registered) and writes the
# reset link to the server console instead of sending it, so local dev needs no
# mail account. Production MUST set them or reset emails silently never arrive.
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Grill
