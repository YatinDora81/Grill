QSTASH_NEXT_SIGNING_KEY=""

# ---- F5: local + Gemini voice lanes ----
NEXT_PUBLIC_LOCAL_TTS="1"                       # "0" disables the in-browser Kokoro voice entirely
GEMINI_TTS_ENABLED="0"                          # "1" turns on the Gemini TTS preview lane (server, cached in S3)
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts" # or gemini-3.1-flash-tts-preview; check AI Studio for what your project can use
GEMINI_TTS_DAILY_BUDGET="12"                    # free-tier RPD on TTS preview models is tiny; keep this small
GEMINI_TTS_CACHE_PREFIX="tts/gemini/"

