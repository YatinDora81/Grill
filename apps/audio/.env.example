# apps/audio configuration.
#
# Nothing here is loaded automatically — there is no python-dotenv call and the
# package.json scripts run bare uvicorn. In production Render supplies these.
# Locally, either export them or run: uvicorn main:app --reload --env-file .env
# (uvicorn[standard] already ships the dotenv support).

# ── Report sweeper (sweeper.py) ───────────────────────────────────────
# This service is the only always-running process in the system, so it hosts the
# loop that calls apps/web's report backstop. With either of the first two unset
# the sweeper logs a warning and stays off; /analyze is unaffected.

# Full URL of the drain endpoint. Must be the FINAL https origin — a redirect is
# refused rather than chased, because the Authorization header would be stripped
# across the hop and arrive unauthenticated.
REPORT_CRON_URL="https://your-app.vercel.app/api/cron/reports"

# MUST byte-match CRON_SECRET on apps/web. Rotate one without the other and this
# 401s forever — GET /health reports exactly that.
CRON_SECRET=""

# ── Optional (defaults shown) ─────────────────────────────────────────
# Set false on every replica but one: N replicas are safe (the claim is atomic,
# so only one wins) but each costs an invocation and a Neon wakeup to lose a race.
REPORT_CRON_ENABLED="true"

# The gap AFTER a run that did work — not a fixed rate. Floored at 1s.
REPORT_CRON_BUSY_GAP_S="5"

# Idle backoff ceiling, +/-15% (jitter is applied after the clamp, so replicas
# don't all wake at once). An empty queue polled every 5s keeps a serverless DB
# awake 24/7, so the gap grows to this when there is nothing to do — which also
# means a backstop can take this long to notice a dead build on a quiet system.
REPORT_CRON_MAX_GAP_S="600"

# Read timeout. MUST exceed the route's maxDuration of 300 — the route sends
# nothing until its drain returns, so a shorter timeout aborts healthy drains and
# manufactures the very failures the sweeper exists to clean up.
REPORT_CRON_TIMEOUT_S="330"

# ── Not currently read ────────────────────────────────────────────────
# For the detachable PC-worker variant (§13), where this service would read audio
# from the bucket itself. The default path has apps/web send the clip in the
# request body, so no storage creds are needed here today.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=interview-audio
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
