# Only needed for the detachable PC-worker variant (§13), where this service
# reads audio from the bucket directly. For the default inline path, Express
# sends the clip in the request and no storage creds are needed here.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=interview-audio
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
