# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# Local env files
# Catch-all, not a list: a bare `.env.production` / `.env.staging` slips past
# enumerated rules, and this repo is public — one miss leaks live keys.
# The example template is the deliberate exception.
.env
.env.*
!.env.example
*.local

# Python (apps/audio)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
.Python
*.egg-info/
.eggs/

# Prisma client is generated by `bun run db:generate`, never committed.
packages/db/generated/

# Testing
coverage/
*.lcov
.nyc_output/

# Turbo / Bun / package caches
.turbo/
.bun/
*.bun-build

# Vercel
.vercel/

# Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Debug / temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log
tmp/
temp/
*.tmp
*.swp
*~

# Editors / tooling
.vscode/
.idea/
.claude/
*.sublime-*
.eslintcache
*.code-workspace

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets / certs (never commit)
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials.json
service-account*.json
