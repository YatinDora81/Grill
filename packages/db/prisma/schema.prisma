generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  emailOnReport Boolean  @default(true) @map("email_on_report")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  timezone     String?   @db.VarChar(64)
  emailDigest  Boolean   @default(true) @map("email_digest")
  lastDigestAt DateTime? @map("last_digest_at") @db.Timestamptz(6)

  sessions            Session[]
  starred             StarredQuestion[]
  questionSets        QuestionSet[]
  passwordResetTokens PasswordResetToken[]
  drillCards          DrillCard[]

  @@map("users")
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum SourceType {
  resume
  jd
  topic

  @@map("source_type")
}

enum SessionStatus {
  in_progress
  generating_report
  completed
  cancelled
  abandoned
  error

  @@map("session_status")
}

enum QuestionType {
  technical
  behavioral
  followup
  cultural

  @@map("question_type")
}

enum QuestionSetSource {
  resume
  topic
  cultural

  @@map("question_set_source")
}

model Session {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceType  SourceType    @map("source_type")
  sourceText  String        @map("source_text")
  name        String?
  role        String?
  config      Json
  status      SessionStatus @default(in_progress)
  errorReason String?       @map("error_reason")

  reportLeaseUntil DateTime? @map("report_lease_until") @db.Timestamptz(6)
  reportAttempts   Int       @default(0) @map("report_attempts")

  retryOfId String?  @map("retry_of_id") @db.Uuid
  retryOf   Session? @relation("SessionRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries   Session[] @relation("SessionRetries")

  audioPurgedAt DateTime? @map("audio_purged_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  questionSetId String?      @map("question_set_id") @db.Uuid
  questionSet   QuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns  Turn[]
  report Report?
  share  ReportShare?
  videos SessionVideo[]

  @@index([userId])
  @@index([status])
  @@index([retryOfId])
  @@index([audioPurgedAt, createdAt])
  @@index([userId, deletedAt])
  @@index([questionSetId])
  @@map("sessions")
}

model QuestionSet {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name   String
  source QuestionSetSource
  sourceText String  @map("source_text")
  role       String?
  difficulty String
  count Int

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    QuestionSetItem[]
  sessions Session[]

  @@index([userId, deletedAt])
  @@map("question_sets")
}

model QuestionSetItem {
  id    String @id @default(uuid()) @db.Uuid
  setId String @map("set_id") @db.Uuid

  itemIndex    Int          @map("item_index")
  question     String
  questionType QuestionType @map("question_type")

  set QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, itemIndex])
  @@index([setId])
  @@map("question_set_items")
}

model StarredQuestion {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  question     String
  questionType QuestionType @map("question_type")
  questionHash String       @map("question_hash") @db.Char(64)

  turnId String? @map("turn_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  turn Turn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@unique([userId, questionHash])
  @@index([userId])
  @@map("starred_questions")
}

model DrillCard {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  question     String
  questionType QuestionType @map("question_type")
  questionHash String       @map("question_hash") @db.Char(64)
  sourceTurnId String?      @map("source_turn_id") @db.Uuid

  ease         Float     @default(2.5)
  intervalDays Int       @default(0) @map("interval_days")
  repetitions  Int       @default(0)
  dueAt        DateTime  @default(now()) @map("due_at") @db.Timestamptz(6)
  lastGrade    Int?      @map("last_grade")
  bestTranscript String? @map("best_transcript")
  bestMean       Float?  @map("best_mean")
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews DrillReview[]

  @@unique([userId, questionHash])
  @@index([userId, suspendedAt, dueAt])
  @@map("drill_cards")
}

model DrillReview {
  id     String @id @default(uuid()) @db.Uuid
  cardId String @map("card_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  grade        Int
  transcript   String?
  answerScores Json?    @map("answer_scores")
  reviewedAt   DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  card DrillCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId])
  @@map("drill_reviews")
}

model SessionVideo {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  key       String
  uploadId  String? @map("upload_id")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turns   Turn[]

  @@index([sessionId])
  @@index([expiresAt])
  @@map("session_videos")
}

model Turn {
  id              String       @id @default(uuid()) @db.Uuid
  sessionId       String       @map("session_id") @db.Uuid
  turnIndex       Int          @map("turn_index")
  question        String
  questionType    QuestionType @map("question_type")
  audioKey        String?      @map("audio_url")
  transcript      String?
  transcriptWords Json?        @map("transcript_words")
  answerScores    Json?        @map("answer_scores")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  videoId       String? @map("video_id") @db.Uuid
  videoOffsetMs Int?    @map("video_offset_ms")

  cameraMetrics Json?   @map("camera_metrics")

  responseLatencyMs    Int?    @map("response_latency_ms")
  interruptedAtS       Int?    @map("interrupted_at_s")
  transcriptConfidence Float?  @map("transcript_confidence")
  questionPayload      Json?   @map("question_payload")
  codeSubmission       Json?   @map("code_submission")
  designKey            String? @map("design_key")
  designImageKey       String? @map("design_image_key")
  designReview         Json?   @map("design_review")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  video   SessionVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  starred StarredQuestion[]

  @@unique([sessionId, turnIndex])
  @@index([sessionId])
  @@index([videoId])
  @@map("turns")
}

model Report {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @unique @map("session_id") @db.Uuid
  overallScore    Int      @map("overall_score")
  verdict         String
  categoryScores  Json     @map("category_scores")
  deliveryMetrics Json     @map("delivery_metrics")
  strengths       Json
  weaknesses      Json
  bestAnswer      Json?    @map("best_answer")
  worstAnswer     Json?    @map("worst_answer")
  nextSteps       Json     @map("next_steps")
  questionFeedback Json    @default("[]") @map("question_feedback")
  starBreakdown   Json     @default("[]") @map("star_breakdown")
  raw             Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model ReportShare {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @unique @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("report_shares")
}

model CompanyBrief {
  id         String @id @default(uuid()) @db.Uuid
  companyKey String @map("company_key") @db.VarChar(120)
  roleKey    String @map("role_key") @db.VarChar(120)

  company String
  role    String?
  brief   Json
  grounded Boolean
  sources  Json @default("[]")
  raw      Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyKey, roleKey])
  @@map("company_briefs")
}
