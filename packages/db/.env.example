# packages/db — Prisma CLI (migrate / push / studio).
# Copy to .env and fill in. NEVER commit real values.
#
# Use the DIRECT (non-pooled) Neon host here. The app runtime
# (apps/web/.env.local) should use the -pooler host instead.

DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&schema=ai_interview"
